# local = grava na pasta ./data | s3 = grava no bucket da AWS
STORAGE_BACKEND=local
S3_BUCKET=case-pipeline-pedro
AWS_REGION=us-east-1
LOCAL_DATA_DIR=data

# Indicador do World Bank: PM2.5 (exposicao media anual, ug/m3)
WB_INDICATOR=EN.ATM.PM25.MC.M3
WB_START_YEAR=2010

# User-Agent descritivo (boa pratica ao acessar a Wikipedia)
HTTP_USER_AGENT=case-pipeline/1.0 (data engineering case)
